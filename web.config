<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- 使用 ASP.NET Core Module 代理 Python：HttpPlatformHandler 會丟掉 WebSocket 的
         Sec-WebSocket-Protocol 回應標頭，導致 Streamlit 前端連線失敗、畫面一直轉圈。 -->
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath=".\runtime\python.exe"
                arguments=".\serve.py"
                hostingModel="OutOfProcess"
                stdoutLogEnabled="true"
                stdoutLogFile="\\?\%home%\LogFiles\python"
                startupTimeLimit="120"
                requestTimeout="00:04:00">
      <environmentVariables>
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <environmentVariable name="MPLCONFIGDIR" value="%HOME%\data\matplotlib" />
      </environmentVariables>
    </aspNetCore>
  </system.webServer>
</configuration>
